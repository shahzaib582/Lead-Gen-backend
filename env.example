# =============================================================================
# Lead Gen backend — environment variables
# Copy to .env and fill in values. Only uncomment optional vars when needed.
# =============================================================================

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
TRUST_PROXY=1

# Public API URL (Swagger, email open-tracking pixel, Calendly per-user webhooks).
# Production example: PUBLIC_BASE_URL=https://leadgen-api.example.com
# PUBLIC_BASE_URL=http://localhost:3000

# Frontend URL (Calendly OAuth redirect, notifications deep links, Stripe return).
FRONTEND_URL=http://localhost:8080

# Comma-separated browser origins (credentials / cookies). FRONTEND_URL is also allowed.
CORS_ORIGIN=http://localhost:8080
# Dev only — allow any Origin locally (never in production).
# CORS_DEV_ALLOW_ANY=1

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=lead_generation_bucket

# ─── JWT / auth ─────────────────────────────────────────────────────────────
# Prefer JWT_ACCESS_SECRET; JWT_SECRET is legacy fallback only.
JWT_ACCESS_SECRET=your-very-long-random-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
# Legacy fallback if JWT_ACCESS_SECRET is unset:
# JWT_SECRET=your-very-long-random-secret-min-32-chars

# BCRYPT_ROUNDS=10

# ─── OTP (email verify / password reset) ────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_EMAIL_BUFFER_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_LIMIT=5
OTP_RESEND_WINDOW_MINUTES=60

# ─── Brevo (transactional email) ────────────────────────────────────────────
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@your-verified-domain.com
BREVO_SENDER_NAME=Lead Gen
# APP_NAME=Lead Gen

# ─── OpenAI (campaign mail templates + follow-ups) ───────────────────────────
OPENAI_API_KEY=sk-your-openai-key

# ─── Lead pipeline (Apollo search + Hunter verify → leads_data) ──────────────
APOLLO_API_KEY=your-apollo-api-key
# HUNTER_API_KEY=your-hunter-api-key
# APOLLO_SEARCH_URL=https://api.apollo.io/api/v1/mixed_people/api_search
# APOLLO_ENRICH_URL=https://api.apollo.io/api/v1/people/bulk_match

# ─── Google OAuth (Gmail send + Calendar meetings) ──────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ─── Redis / BullMQ (workers + campaign SSE) ────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Full URL overrides host/port (include password in URL if needed):
# REDIS_URL=redis://127.0.0.1:6379

# ─── Campaign mail timing ─────────────────────────────────────────────────────
# MAIL_DELAY_MIN_MS=180000
# MAIL_DELAY_MAX_MS=300000
# MANUAL_RUN_INSTANT_MAX_LEADS=15
# MANUAL_RUN_SMALL_BATCH_GAP_MS=2000
# MANUAL_RUN_BANNER_MIN_LEADS=6

# ─── Workers / campaigns ────────────────────────────────────────────────────
# RUN_WORKERS_IN_WEB=1
# CAMPAIGN_ACTIVE_CREATE_AUTO_ASSIGN=1
# FOLLOW_UP_CRON=0 */6 * * *

# ─── Thank-you Gmail draft (when lead replies) ──────────────────────────────
# THANK_YOU_DRAFT_BODY=Hi {{firstName}},\n\nThank you for your reply.\n\nBook a time: {{bookingLink}}\n\nBest,\n{{senderName}}

# ─── Calendly (per-user OAuth — https://developer.calendly.com) ─────────────
# CALENDLY_CLIENT_ID=
# CALENDLY_CLIENT_SECRET=
# CALENDLY_REDIRECT_URI=http://localhost:3000/api/auth/calendly/callback
# Optional legacy fallbacks (not needed with per-user OAuth):
# CALENDLY_WEBHOOK_SIGNING_KEY=
# CALENDLY_PERSONAL_ACCESS_TOKEN=

# ─── Firebase Cloud Messaging (optional push) ─────────────────────────────────
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Stripe billing (optional) ──────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_BILLING_PORTAL_CONFIGURATION_ID=bpc_...

# ─── Logging (optional) ─────────────────────────────────────────────────────
# LOG_LEVEL=info
# LOG_HTTP_SKIP_304=1
